# Copy to .env (local) and set the same variables in Vercel → Project → Settings → Environment Variables.

# Neon: "Pooled connection" string (host contains -pooler). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: "Direct connection" string (same, without -pooler). Used by migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Public address of the site (used in password-reset links).
APP_URL="http://localhost:3000"
